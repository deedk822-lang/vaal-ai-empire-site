# ============================================
# VAAL AI EMPIRE - VERCEL ENVIRONMENT VARIABLES
# Copy these to Vercel Dashboard → Settings → Environment Variables
# ============================================

# Application
NODE_ENV=production
DOMAIN=https://vaal-ai-empire-site.vercel.app
STAGING_URL=https://vaal-ai-empire-site.vercel.app

# AI API Keys (from GitHub Secrets)
CODERABBIT_API_KEY=${CODERABBIT_API_KEY}
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}
GLM5_API_KEY=${GLM5_API_KEY}
KIMI_API_KEY=${KIMI_API_KEY}
OLLAMA_API_KEY=${OLLAMA_API_KEY}

# Observability (from GitHub Secrets)
PROMETHEUS_URL=${PROMETHEUS_URL}
PROMETHEUS_USER=${PROMETHEUS_USER}
PROMETHEUS_API_KEY=${PROMETHEUS_API_KEY}
GRAFANA_API_KEY=${GRAFANA_API_KEY}
GRAFANA_DATASOURCE_NAME=${GRAFANA_DATASOURCE_NAME}
OPENTELEMETRY_API_KEY=${OPENTELEMETRY_API_KEY}
PERPLEXITY_API_KEY=${PERPLEXITY_API_KEY}

# Vercel (from GitHub Secrets)
VERCEL_API_KEY=${VERCEL_API_KEY}
VERCEL_TOKEN=${VERCEL_TOKEN}

# CORS
ALLOWED_ORIGINS=https://vaal-ai-empire-site.vercel.app

# Auth (generate a secure secret)
JWT_SECRET=vaal-empire-jwt-secret-production-2024

# PayFast (placeholder - configure later)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Pricing (in cents)
VAAL_STARTER_PRICE=99900
VAAL_EMPIRE_PRICE=299900
