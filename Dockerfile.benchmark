# Vaal AI Empire - Benchmark Docker Image
# Multi-stage build with non-root user and healthcheck
# 
# Build: docker build -f Dockerfile.benchmark -t vaal-benchmark .
# Run: docker run -v $(pwd)/benchmark_results:/app/benchmark_results vaal-benchmark

ARG PYTHON_VERSION=3.11
ARG NODE_VERSION=20

# ============================================
# Stage 1: Base Python Dependencies
# ============================================
FROM python:${PYTHON_VERSION}-slim AS python-base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt || \
    pip install --no-cache-dir pytest pytest-asyncio requests prometheus-client aiohttp

# ============================================
# Stage 2: Node.js Dependencies (Optional)
# ============================================
FROM node:${NODE_VERSION}-slim AS node-base

WORKDIR /app

# Copy package files
COPY package*.json ./ 2>/dev/null || true

# Install dependencies (continue on error)
RUN npm ci --only=production 2>/dev/null || npm install --production 2>/dev/null || true

# ============================================
# Stage 3: Final Runtime Image
# ============================================
FROM python:${PYTHON_VERSION}-slim AS runtime

# Build arguments
ARG USERNAME=benchmark
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BENCHMARK_OUTPUT_DIR=/app/benchmark_results \
    NODE_ENV=production \
    PATH="/home/$USERNAME/.local/bin:$PATH"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && mkdir -p /app/benchmark_results \
    && chown -R $USERNAME:$USERNAME /app

# Copy Python packages from python-base
COPY --from=python-base /usr/local/lib/python${PYTHON_VERSION}/site-packages /usr/local/lib/python${PYTHON_VERSION}/site-packages
COPY --from=python-base /usr/local/bin /usr/local/bin

# Copy application code
WORKDIR /app

# Copy benchmark files with proper ownership
COPY --chown=$USERNAME:$USERNAME agents/ ./agents/
COPY --chown=$USERNAME:$USERNAME benchmark_data/ ./benchmark_data/

# Copy server if it exists
COPY --chown=$USERNAME:$USERNAME server/ ./server/ 2>/dev/null || true

# Create benchmark results directory
RUN mkdir -p /app/benchmark_results && chown -R $USERNAME:$USERNAME /app/benchmark_results

# Switch to non-root user
USER $USERNAME

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Labels for metadata
LABEL maintainer="Vaal AI Empire" \
      description="Benchmark suite for AI model evaluation with Kimi K2.5 + GLM-5" \
      version="2.0.0" \
      org.opencontainers.image.source="https://github.com/deedk822-lang/vaal-ai-empire-site"

EXPOSE 8000

# Default command - runs hybrid benchmark executor
ENTRYPOINT ["dumb-init", "--"]
CMD ["python", "agents/benchmark_executor.py", "--run-all", "--report", "--backend", "auto"]
