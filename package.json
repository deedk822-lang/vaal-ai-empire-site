{
  "name": "vaal-ai-empire",
  "version": "1.0.0",
  "description": "South Africa's first autonomous AI empire - Built in the Vaal Triangle",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:agents": "python agents/ag2/orchestrator.py",
    "test": "jest --config server/jest.config.js",
    "test:watch": "jest --config server/jest.config.js --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "ai",
    "south-africa",
    "tax-recovery",
    "crisis-detection",
    "sars",
    "cohere",
    "ag2",
    "autogen",
    "multi-agent"
  ],
  "author": "Vaal AI Empire",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "mongodb": "^6.3.0",
    "stripe": "^14.10.0",
    "@sendgrid/mail": "^8.1.0",
    "dotenv": "^16.3.1",
    "cohere-ai": "^7.6.0",
    "hnswlib-node": "^3.0.0",
    "axios": "^1.6.0",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.11.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.4",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6",
    "validator": "^13.11.0",
    "colors": "^1.4.0",
    "body-parser": "^1.20.2",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.10.0"
  }
}
