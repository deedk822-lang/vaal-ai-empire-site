{
  "name": "vaal-ai-empire",
  "version": "1.0.0",
  "description": "South Africa's first autonomous AI empire - Built in the Vaal Triangle",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:agents": "python agents/ag2/orchestrator.py",
    "test": "jest --config server/jest.config.js",
    "test:watch": "jest --config server/jest.config.js --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "ai",
    "south-africa",
    "tax-recovery",
    "crisis-detection",
    "sars",
    "cohere",
    "ag2",
    "autogen",
    "multi-agent"
  ],
  "author": "Vaal AI Empire",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "cohere-ai": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "hnswlib-node": "^3.0.0",
    "mongodb": "^7.1.0",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^2.1.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.10.0"
  }
}
