# ============================================
# VAAL AI EMPIRE - Server Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=4242
DOMAIN=http://localhost:4242

# ============================================
# PAYFAST PAYMENT GATEWAY (South Africa)
# ============================================
# Get these from: https://www.payfast.co.za/
# After signup, go to Settings > Integration

# Sandbox (Testing) - Replace with your actual sandbox credentials
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=your-merchant-key-here
PAYFAST_SIGNATURE_SALT=your-passphrase-here

# Sandbox mode (set to false for production)
PAYFAST_SANDBOX=true

# PayFast URLs (auto-configured)
# Sandbox: https://sandbox.payfast.co.za/eng/process
# Production: https://www.payfast.co.za/eng/process

# ============================================
# PRICING (in ZAR - South African Rand)
# ============================================
VAAL_STARTER_PRICE=99900
VAAL_EMPIRE_PRICE=299900

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ============================================
# DATABASE (MongoDB)
# ============================================
# Get free database from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/vaal-ai-empire

# ============================================
# AI API KEYS (Already configured in GitHub)
# ============================================
GLM5_API_KEY=
KIMI_API_KEY=
DASHSCOPE_API_KEY=

# ============================================
# EMAIL (Optional - for verification)
# ============================================
EMAIL_FROM=noreply@vaalai.co.za
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# SECURITY
# ============================================
ALLOWED_ORIGINS=http://localhost:4242,http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false

# ============================================
# GRAFANA / PROMETHEUS (Already in GitHub Secrets)
# ============================================
PROMETHEUS_URL=
PROMETHEUS_USER=
PROMETHEUS_PASSWORD=
GRAFANA_DATASOURCE_NAME=

# ============================================
# VERCEL DEPLOYMENT
# ============================================
# Your Vercel URL after deployment
STAGING_URL=https://vaal-ai-empire-site.vercel.app
