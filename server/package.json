{
  "name": "vaal-ai-empire-server",
  "version": "1.0.0",
  "description": "Vaal AI Empire Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "diagnose": "node agents/diagnostic-runner.js",
    "test:auth": "node agents/auth-validator.js",
    "test:security": "node agents/security-auditor.js",
    "test": "npm run diagnose",
    "lint": "eslint . || true",
    "audit:check": "npm audit --audit-level=high --omit=dev"
  },
  "keywords": [
    "ai",
    "vaal",
    "empire",
    "backend"
  ],
  "author": "Vaal AI Empire",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "picocolors": "^1.1.1",
    "prom-client": "^15.1.3",
    "validator": "^13.15.0",
    "winston": "^3.17.0",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "minimatch": "^5.1.2",
    "glob": "^10.4.5",
    "rimraf": "^5.0.10",
    "inflight": "npm:lru-cache@^10.4.3"
  }
}
