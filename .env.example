# ============================================
# VAAL AI EMPIRE - ENVIRONMENT CONFIGURATION
# Built in the Vaal. Built for Africa. 🇿🇦
# ============================================

# ===================
# APPLICATION
# ===================
NODE_ENV=production
PORT=3000
DOMAIN=https://vaal-ai-empire-site.vercel.app

# ===================
# DATABASE (MongoDB)
# ===================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vaal-empire

# ===================
# AUTHENTICATION
# ===================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ===================
# PAYFAST CONFIGURATION
# South Africa's Leading Payment Gateway
# ===================
# Get your credentials from: https://www.payfast.co.za/
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true

# ===================
# PRICING (in cents)
# ===================
VAAL_STARTER_PRICE=99900
VAAL_EMPIRE_PRICE=299900

# ===================
# AI API KEYS
# ===================
CODERABBIT_API_KEY=your-coderabbit-key
DASHSCOPE_API_KEY=your-dashscope-key
GLM5_API_KEY=your-glm5-key
KIMI_API_KEY=your-kimi-key
OLLAMA_API_KEY=your-ollama-key

# ===================
# OBSERVABILITY
# ===================
PROMETHEUS_URL=https://prometheus.example.com
PROMETHEUS_USER=admin
PROMETHEUS_API_KEY=your-prometheus-key
GRAFANA_API_KEY=your-grafana-key
GRAFANA_DATASOURCE_NAME=Prometheus

# ===================
# DEPLOYMENT
# ===================
VERCEL_TOKEN=your-vercel-token
STAGING_URL=https://vaal-ai-empire-site.vercel.app

# ===================
# CORS SETTINGS
# ===================
ALLOWED_ORIGINS=https://vaal-ai-empire-site.vercel.app,https://vaal-ai-empire-site-git-main-deedk822.vercel.app

# ===================
# SECURITY
# ===================
# Rate limiting is built-in
# Session secret for cookie signing
SESSION_SECRET=your-session-secret-change-this
