# Vaal AI Empire - Environment Configuration
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════════════
# AI Provider API Keys (Primary Services)
# ═══════════════════════════════════════════════════════════════════

# Moonshot AI (Kimi) - https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here

# Alibaba Cloud Dashscope (Qwen) - https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Zhipu AI (GLM) - https://open.bigmodel.cn/
GLM5_API_KEY=your_glm_api_key_here

# ═══════════════════════════════════════════════════════════════════
# Local AI Services (Fallback)
# ═══════════════════════════════════════════════════════════════════

# Ollama - Local LLM server
OLLAMA_API_KEY=ollama
OLLAMA_HOST=http://localhost:11434

# LocalAI - OpenAI-compatible local server
LOCALAI_API_KEY=localai
LOCALAI_URL=http://localhost:8080/v1

# ═══════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vaal_ai_empire
MONGODB_DB_NAME=vaal_ai_empire

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════
# Authentication & Security
# ═══════════════════════════════════════════════════════════════════

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=7d

# Session Secret
SESSION_SECRET=your_session_secret_here

# Bcrypt Salt Rounds
BCRYPT_ROUNDS=12

# ═══════════════════════════════════════════════════════════════════
# XRPL (XRP Ledger) Configuration
# ═══════════════════════════════════════════════════════════════════

# XRPL Account Seed (keep this SECRET!)
XRPL_AGENT_SEED=your_xrpl_seed_here

# XRPL Network (testnet/devnet/mainnet)
XRPL_NETWORK_URL=https://s.altnet.rippletest.net:51234

# ═══════════════════════════════════════════════════════════════════
# Payment Integration
# ═══════════════════════════════════════════════════════════════════

# PayFast Configuration
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_SIGNATURE_SALT=your_payfast_passphrase
PAYFAST_SANDBOX=true

# Stripe (optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ═══════════════════════════════════════════════════════════════════
# External Services
# ═══════════════════════════════════════════════════════════════════

# SendGrid (Email)
SENDGRID_API_KEY=SG.your_sendgrid_key

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ═══════════════════════════════════════════════════════════════════
# Monitoring & Observability
# ═══════════════════════════════════════════════════════════════════

# Grafana
GRAFANA_API_KEY=your_grafana_api_key
GRAFANA_DATASOURCE_NAME=Prometheus
GRAFANA_GITHUB=your_github_token_for_grafana

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_USER=admin
PROMETHEUS_API_KEY=your_prometheus_key

# OpenTelemetry
OPENTELEMETRY_API_KEY=your_otel_key

# ═══════════════════════════════════════════════════════════════════
# Deployment Configuration
# ═══════════════════════════════════════════════════════════════════

# Vercel
VERCEL_TOKEN=your_vercel_token
VERCEL_API_KEY=your_vercel_api_key

# Domain
DOMAIN=vaal-ai-empire-site.vercel.app
STAGING_URL=https://staging.vaal-ai-empire-site.vercel.app

# ═══════════════════════════════════════════════════════════════════
# Bot & Automation
# ═══════════════════════════════════════════════════════════════════

# Telegram Bot
VAAL_MONEY_BOT=your_telegram_bot_token

# CodeRabbit
CODERABBIT_API_KEY=your_coderabbit_key

# ═══════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════

# Environment
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,https://vaal-ai-empire-site.vercel.app

# Feature Flags
ENABLE_AI_FALLBACK=true
ENABLE_XRPL_INTEGRATION=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_VOICE_PROCESSING=true
