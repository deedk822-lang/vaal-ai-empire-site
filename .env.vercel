# Vercel Environment Variables
# Import this file directly into Vercel Dashboard

# Application
NODE_ENV=production
DOMAIN=https://vaal-ai-empire-site.vercel.app
STAGING_URL=https://vaal-ai-empire-site.vercel.app

# PayFast (Update with your credentials from payfast.co.za)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Pricing (in cents - R999.00 and R2,999.00)
VAAL_STARTER_PRICE=99900
VAAL_EMPIRE_PRICE=299900

# CORS
ALLOWED_ORIGINS=https://vaal-ai-empire-site.vercel.app

# Auth
JWT_SECRET=vaal-empire-jwt-secret-change-in-production
